{
  "name": "@active-collaboration/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "eaf — command-line interface for the Active Collaboration platform (P2e): auth, environments, devices, agents, catalog, simulations, and declarative world documents",
  "main": "./dist/main.js",
  "bin": {
    "eaf": "dist/main.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/main.ts",
    "start": "node dist/main.js",
    "test": "node ../../node_modules/vitest/vitest.mjs --run",
    "test:fast": "node ../../node_modules/vitest/vitest.mjs run --config vitest.fast.config.ts",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@active-collaboration/core": "*",
    "ws": "^8.16.0",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/node": "20.19.39",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "1.6.1"
  }
}
