{
  "name": "@active-collaboration/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Web console for the Active Collaboration engine (P1): scenario explorer + live simulation console",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:fast": "vitest run",
    "sync-types": "openapi-typescript ../../apps/server/openapi.yaml --empty-objects-unknown -o src/api/generated.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@active-collaboration/shared": "*",
    "@babylonjs/core": "^9.25.0",
    "@babylonjs/gui": "^9.25.0",
    "@tanstack/react-query": "^5.101.4",
    "earcut": "^3.2.3",
    "echarts": "^6.1.0",
    "i18next": "^23.16.8",
    "i18next-browser-languagedetector": "^8.0.4",
    "leaflet": "1.9.4",
    "lucide-react": "^1.28.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-i18next": "^15.1.3",
    "react-resizable-panels": "^3.0.6",
    "react-router-dom": "^6.30.4",
    "reactflow": "11.11.4",
    "zustand": "4.5.5"
  },
  "devDependencies": {
    "@testing-library/react": "14.3.1",
    "@types/leaflet": "1.9.12",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "4.3.4",
    "jsdom": "24.1.3",
    "openapi-typescript": "^7.13.0",
    "typescript": "5.9.3",
    "vite": "5.4.21",
    "vitest": "1.6.1"
  }
}
