{
  "name": "@active-collaboration/server",
  "version": "0.1.0",
  "private": true,
  "description": "Fastify REST + WebSocket API server for the Active Collaboration engine (P0)",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc --build",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "clean": "rm -rf dist *.tsbuildinfo",
    "test": "node --max-old-space-size=16384 ../../node_modules/vitest/vitest.mjs run",
    "test:fast": "node --max-old-space-size=16384 ../../node_modules/vitest/vitest.mjs run --config vitest.fast.config.ts",
    "test:run": "node --max-old-space-size=16384 ../../node_modules/vitest/vitest.mjs --run"
  },
  "dependencies": {
    "@active-collaboration/core": "*",
    "@active-collaboration/llm-integration": "*",
    "@active-collaboration/simulation": "*",
    "@fastify/compress": "^8.3.1",
    "@fastify/cookie": "^11.1.2",
    "@fastify/jwt": "^10.2.0",
    "@fastify/static": "^8.3.0",
    "@fastify/websocket": "^11.2.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "fastify": "^5.2.0",
    "ws": "^8.16.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.10.0",
    "@types/ws": "^8.5.10",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^1.0.0"
  }
}
