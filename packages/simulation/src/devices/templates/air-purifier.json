    {
      "name": "set-fan-speed",
      "type": "write",
      "description": "Set fan speed",
      "parameters": [
        {
          "name": "speed",
          "type": "number",
          "required": true,
          "description": "Fan speed percentage (0-100)"
        }
      ]
    },
    {
      "name": "turn-on",
      "type": "write",
      "description": "Turn on the air purifier",
      "parameters": []
    },
    {
      "name": "turn-off",
      "type": "write",
      "description": "Turn off the air purifier",
      "parameters": []
    }
  ],
  "defaultState": {
    "status": "off",
    "power": false,
    "mode": "auto",
    "fanSpeed": 50,
    "pm25": 0,
    "voc": 0
