{
  "name": "@active-collaboration/simulation",
  "version": "0.1.0",
  "private": true,
  "description": "IoT device simulation framework",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build --watch",
    "clean": "rm -rf dist",
    "test": "vitest",
    "test:run": "tsx src/test.ts",
    "test:coverage": "vitest --coverage",
    "test:e2e": "playwright test",
    "demo": "start src/demo/scenario-demo.html",
    "demo:run": "tsx src/demo/ScenarioExecutionDemo.ts"
  },
  "dependencies": {
    "@active-collaboration/core": "*",
    "@active-collaboration/llm-integration": "*",
    "@active-collaboration/shared": "*",
    "uuid": "^9.0.1"
  },
  "peerDependencies": {
    "@active-collaboration/core": "*"
  },
  "devDependencies": {
    "@active-collaboration/core": "*",
    "@types/node": "^20.10.0",
    "@types/uuid": "^9.0.8",
    "@vitest/coverage-v8": "^1.6.1",
    "tsx": "^4.21.0",
    "typescript": "^5.3.3",
    "vitest": "^1.6.1"
  }
}
