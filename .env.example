# Embodied Agent Framework — environment template
# Copy to `.env` and adjust. Every variable is optional; defaults are
# repo-relative (see apps/server/src/config.ts). Docker compose sets
# EAF_DB_PATH / EAF_TRAJECTORY_DIR / WEB_DIST itself — no need to repeat.

# --- HTTP server ---
# Listen port (default 8100)
PORT=8100
# Listen host (default 0.0.0.0)
HOST=0.0.0.0

# --- i18n (zh/en, future ja/ko) ---
# CLI human-mode output language. Default en-US (operator tool); set to
# zh-CN (or any zh* tag) for Chinese. JSON output (`--json`) is never
# localized. The web app reads locale from localStorage `eaf-lang`, then
# navigator.language; the server reads Accept-Language / ?lang= and
# defaults to zh-CN. See packages/shared/src/i18n.ts for the canonical
# resolver and apps/{server,cli,web}/src/i18n/* for the catalogs.
EAF_LANG=en-US

# --- Auth ---
# JWT signing secret — REQUIRED in strict mode (NODE_ENV=production, or
# EAF_STRICT_ENV=1): the server REFUSES TO BOOT without it, because the
# fallback development key is printed in the public source tree. Generate
# with: openssl rand -hex 32
JWT_SECRET=
# Force strict-mode config enforcement outside NODE_ENV=production (bare
# metal / systemd boots that never set NODE_ENV). 1 = strict.
EAF_STRICT_ENV=

# --- LLM decision-making (optional; without it scenarios run rule-only) ---
# R44-B: the Ollama backend was removed — an OpenAI-compatible endpoint
# (vLLM / LM Studio / cloud gateways — anything speaking the
# /v1/chat/completions protocol) is the sole backend.
# LLM_PROVIDER: openai-compatible (default) | vllm (official alias)
LLM_PROVIDER=
# Endpoint base URL. In docker use http://host.docker.internal:8000/v1 to
# reach a vLLM running on the host (compose already defaults to this).
LLM_BASE_URL=http://127.0.0.1:8000/v1
# API key (optional — local vLLM is typically unauthenticated)
LLM_API_KEY=
# Model name (required for the provider; must match the server's
# --served-model-name, e.g. qwen3-8b)
LLM_MODEL=
# '1' = strict model matching: a request whose model differs from LLM_MODEL
# errors instead of being rewritten to LLM_MODEL (default off — normalize).
LLM_MODEL_STRICT=
# Per-function model routing (all optional; unset = every call site uses
# LLM_MODEL, single-backend behavior). Value: a bare model name (served by
# LLM_BASE_URL) or model@http(s)://host:port/v1 (another vLLM instance).
#   LLM_DECISION_MODEL  AC necessity decisions + triage
#   LLM_EVAL_MODEL      proposal-response evaluation
#   LLM_NL_MODEL        NL intent parsing + proposal review
# Routed clients normalize/strict against their OWN route model
# (LLM_MODEL_STRICT applies per route); /api/health decision.routes echoes
# the table.
LLM_DECISION_MODEL=
LLM_EVAL_MODEL=
LLM_NL_MODEL=
# Qwen3 thinking suppression on the structured-output lanes (AC decision,
# proposal evaluation, triage — guided-JSON output, so the <think> draft is
# pure latency). Default on; '0' restores the default template (A/B).
# chat_template_kwargs is a vLLM extension — set 0 if a non-vLLM backend
# rejects the field.
LLM_DISABLE_THINKING=
# Global LLM request-queue concurrency limit (R15-C1, default 3). Classroom
# with a beefy backend: raise to match what the model server can take.
LLM_MAX_CONCURRENT=3
# Fast-lane queue for ac-decision* small models (R44-F1): adaptive concurrency
# between MIN and MAX (defaults 8/32) — scales up while the queue stays busy
# and the backend is healthy, halves on 429 / elevated failure rate.
# Pin LLM_FAST_LANE_CONCURRENT to disable adaptation (capacity experiments).
LLM_FAST_LANE_MIN=
LLM_FAST_LANE_MAX=
LLM_FAST_LANE_CONCURRENT=
# Small-model triage for AC decisions (P4-2): the OLLAMA_TRIAGE_MODEL env
# was removed with the backend (R44-B) — set the triage model per
# simulation via options.triage.model instead.
# Proposal reviewer selection (P-B): auto | llm | escalating (default auto —
# LLM reviewer when the LLM backend is configured, escalate-everything
# otherwise)
PROPOSAL_REVIEWER=
# (The OLLAMA_REVIEW_MODEL env was removed with the backend in R44-B.)
# SQLite file for the shared LLM response cache (P4-2; unset = in-memory only).
# In docker point it into the volume, e.g. /data/llm-cache.db
LLM_CACHE_PATH=
# F4-2 VCR replay (docs/ci.md): '1' = chat() serves ONLY from the response
# cache; a miss throws LLMReplayMissError with the request fingerprint.
LLM_REPLAY=
# F4-4 fault-injection knobs (docs/ci.md): shorten the backend-liveness probe
# cadence / flip threshold and the circuit-breaker cooldown so kill/recover
# drills flip the decision posture within seconds. Defaults 30000 / 2 / 300000.
LLM_LIVENESS_INTERVAL_MS=
LLM_LIVENESS_FAILURE_THRESHOLD=
LLM_BREAKER_COOLDOWN_MS=
# Wall-clock budget for one proposal-review LLM call in ms (default 60000).
# Cold-start large models (e.g. qwen3-14b) need more than the old fixed 15s.
PROPOSAL_REVIEW_LLM_TIMEOUT_MS=60000
# Policy when the review LLM call fails/times out (default true): LOW-risk
# proposals that passed the rule check auto-approve (aiReview.source =
# 'review-timeout-auto-approve'; owner can revert). Set false to restore
# escalate-on-failure. Medium/high risk never auto-approves.
PROPOSAL_REVIEW_TIMEOUT_AUTO_APPROVE=true

# --- Vision LLM (floor-plan import lane, optional) ---
# POST /api/environments/import-floorplan needs a VISION-capable model; the
# main LLM_MODEL is typically text-only. Point these at an OpenAI-compatible
# endpoint serving a multimodal model (e.g. a vLLM instance running
# Qwen2.5-VL). Unset = the lane falls back to the main LLM_BASE_URL and
# fails honestly (503/502) when that model cannot see images.
# Provider: openai-compatible (default) | siliconflow
EAF_VISION_PROVIDER=
EAF_VISION_BASE_URL=
# Vision model id served at the base URL (default Qwen/Qwen2.5-VL-7B-Instruct)
EAF_VISION_MODEL=

# --- Home Assistant bridge (optional; both must be set) ---
# HA WebSocket API URL, ws(s):// or http(s):// ("/api/websocket" appended if missing)
HASS_URL=
# HA long-lived access token
HASS_TOKEN=
# Safety-gate fallback when no policy row matches an entity: allow | confirm | deny
# (default confirm — real actuation parks for human approval)
HASS_DEFAULT_POLICY=confirm
# Per-entity actuation token bucket per minute (default 6)
HASS_RATE_LIMIT_PER_MIN=6
# Comma-separated emails allowed to write GLOBAL (env-less) hass policies
# (also gates /api/admin/observability and the platform-invite admin API)
ADMIN_EMAILS=
# Alpha capacity gating: registration requires a platform invite code.
# Default ON in strict mode (NODE_ENV=production / EAF_STRICT_ENV=1), OFF in
# development; set 1/0 to override. When ON with no usable invite, boot mints
# a single-use bootstrap code for the first ADMIN_EMAILS entry (startup log).
# Admin ops: eaf admin invites list|create|revoke (see docs/deployment.md §3.2)
EAF_INVITE_ONLY=

# --- Production hardening (R32-C) ---
# CORS allow-list for cross-origin API consumers (comma-separated EXACT
# origins, e.g. https://partner.example.com). Empty (default) = CORS off —
# the web console is same-origin and needs nothing. Credentials are allowed
# for listed origins so the JWT header works cross-origin.
EAF_CORS_ORIGINS=
# Content-Security-Policy header (default on; set off to disable). The
# default policy is console-compatible: same-origin scripts/styles, inline
# styles, data: images, same-origin + ws connections.
EAF_CSP=on
# Strict-Transport-Security header (default off — enable only behind a TLS
# terminator; sending HSTS from a plain-HTTP origin is meaningless).
EAF_HSTS=

# --- Rate limiting (P4-4; in-process fixed window per IP × route class) ---
# Master switch (default enabled; the test harness disables it)
RATE_LIMIT_ENABLED=true
# Requests/min on /api/auth/* (default 30 — register→login bursts and several
# users behind one NAT should not trip it; lower only if you see abuse)
RATE_LIMIT_AUTH_PER_MIN=30
# Requests/min on read-only session endpoints (GET /api/auth/me; default 300 —
# R76-F1: the per-page-load session restore must not share the auth bucket)
RATE_LIMIT_SESSION_PER_MIN=300
# Requests/min on heavy writes: sim create + device/agent create (default 30)
RATE_LIMIT_WRITE_PER_MIN=30
# Requests/min on everything else (default 300)
RATE_LIMIT_GLOBAL_PER_MIN=300

# --- Usage quotas (P4-4 / P-C) ---
# Environments one user may own (default 20)
QUOTA_MAX_ENVS_PER_USER=20
# Device instances per environment (default 200)
QUOTA_MAX_DEVICES_PER_ENV=200
# Agent instances per environment (default 50)
QUOTA_MAX_AGENTS_PER_ENV=50
# Running+paused simulations created by one user (default 3)
QUOTA_MAX_RUNNING_SIMS_PER_USER=3
# Active sandbox forks one user may hold in one environment (default 3)
QUOTA_MAX_SANDBOXES_PER_USER_PER_ENV=3
# Sandbox-fork retention (S3): active forks idle longer than this many days
# are swept at boot and hourly — row stopped (quota slot released), fork sim
# + trajectory dir deleted. Fork SOURCE environments are never touched.
# Default 7; 0 disables the sweep.
EAF_FORK_MAX_AGE_DAYS=7

# --- Service consumption (Fix-11) ---
# Settlement SPI selection: only "null" ships in this distribution (no
# amounts; settle archives a receipt). Any other value fails fast at boot.
SETTLEMENT_PROVIDER=null
# AC handshakes auto-land metered ephemeral agreements (default true)
AC_EPHEMERAL_AGREEMENTS=true
# Agreement observation stream ping/pong cadence in ms (Fix-15; default
# 30000). One missed pong terminates the socket so dead peers stay metered.
AGREEMENT_STREAM_HEARTBEAT_MS=30000
# Wall-clock budget for ONE run inside a batch evaluation (Wave-3a; ms,
# default 300000 = 5 min)
EAF_EVAL_RUN_TIMEOUT_MS=300000

# --- Storage ---
# SQLite database file (default <repo>/data/eaf.db; ":memory:" for tests)
EAF_DB_PATH=
# Base dir for per-simulation trajectory capture (default <repo>/data/trajectories)
EAF_TRAJECTORY_DIR=
# Built web console directory served at "/" (default <repo>/apps/web/dist)
WEB_DIST=

# --- Scenario dirs (rarely overridden) ---
# Bundled read-only seed scenarios (default <repo>/config/scenarios)
SCENARIO_SEED_DIR=
# Writable user scenario store, created on startup (default <repo>/data/scenarios)
SCENARIO_USER_DIR=
# WebSocket snapshot cadence in simulated seconds (default 5)
SNAPSHOT_EVERY_SIM_SEC=5
# Zone-parameter sampling cadence for replay timelines, in simulated seconds (default 60)
EAF_ZONE_SAMPLE_SIM_SEC=60
# Per-request cap on manual step ticks, POST /api/simulations/:id/step
# (Fix-42b, default 600 — "step to 08:00 at speed 60" = 480 ticks fits).
# One oversized step used to freeze the whole API for minutes; step in
# chunks instead of raising this.
EAF_MAX_STEP_TICKS=600

# --- Logging ---
# Global log level: debug | info | warn | error | silent (default info).
# Drives both the framework logger and the Fastify HTTP logger; 'debug' also
# lifts the built-in per-tick physics/device noise suppression.
LOG_LEVEL=info
# Per-module level overrides as JSON (prefix-matched), e.g.
# {"PhysicsLayer":"info","CognitiveAgent":"debug"} — invalid JSON degrades to
# the built-in defaults with one startup warning.
EAF_LOG_MODULE_LEVELS=
# Tee ALL logs (framework + HTTP) to this file in addition to stdout
# (default unset = pure stdout, docker-friendly).
LOG_FILE=
# Rotation threshold for LOG_FILE in bytes, KB/MB suffix ok (default 10MB)
LOG_MAX_SIZE=10485760
# Rotated generations to keep: app.log.1 … app.log.N, oldest deleted (default 5)
LOG_MAX_FILES=5
