{
  "name": "distributed-embodiment",
  "version": "2.0.0-artifact",
  "private": true,
  "description": "Distributed Embodiment: Autonomous AI Agent Collaboration through IoT Infrastructure — Active Collaboration (AC) framework, paper artifact",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "build:all": "npm run build",
    "start": "node apps/server/dist/index.js",
    "build:shared": "npm run build -w @active-collaboration/shared",
    "eaf": "tsx apps/cli/src/main.ts",
    "test": "turbo run test",
    "test:fast": "turbo run test:fast",
    "test:experiments": "npm run test:experiments -w @active-collaboration/core",
    "e2e:ui": "npm run smoke --prefix data/campus-e2e/ui",
    "lint": "turbo run lint",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "fast-check": "^4.9.0",
    "ts-node": "^10.9.2",
    "turbo": "^1.11.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
